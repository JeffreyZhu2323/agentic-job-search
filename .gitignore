*.aux
*.log
*.out
out.txt

# Local resume-fact source sync state (managed by the sync-sources hook / sync-facts skill)
assets/.sources-status
assets/.src-*.hash
assets/.seen-assets

# Local map-sync baselines (managed by /check-map + /sync-docs)
.claude/.docmap/

# Track the resumes archive folder, but never commit the personal resumes in it
data/resumes/*
!data/resumes/.gitkeep

# second git-dir for the public repo
.public.git/

# Gmail /inbox skill: processed-message watermark (local state) + build caches
data/.inbox-state
tools/gmail-mcp/__pycache__/
# OAuth secrets live in ~/.gmail-mcp/ (outside the repo); never commit them.
